# Root folder that contains library subfolders (Movies, Series, Music, …)
MEDIA_PATH=/media

# SQLite + app data (+ cache/transcode, cache/thumbs, cache/subs)
DATA_PATH=/data

# HTTP port
PORT=8096

# Initial admin password (user "admin" is created on first start)
ADMIN_PASSWORD=changeme

# Public base URL for share links, VLC stream URLs and QR codes.
# Can also be set from the UI: Administration -> "Acces externe & Reseau".
# Examples: https://mon-nas.synology.me  http://192.168.1.50:8096  https://media.tailnet.ts.net
PUBLIC_BASE_URL=http://localhost:8096

# ---- Security (1.6.0) ----
# Only these reverse proxies may set X-Forwarded-For / -Proto / -Host.
# Default: loopback, link-local and private addresses (DSM Reverse Proxy,
# Docker bridge, Tailscale serve, nginx on the NAS). Never "true" / "everyone".
# Value: an Express subnet list, a hop count, or 0/false to trust nobody.
# TRUST_PROXY_HOPS=loopback, linklocal, uniquelocal
# Legacy alias: TRUST_PROXY=0 disables it, TRUST_PROXY=1 uses the safe default.
# TRUST_PROXY=1

# HMAC secret for signed share access tokens. When unset, a random 256-bit
# secret is generated once in DATA_PATH/session.secret (mode 600).
# SESSION_SECRET=

# Minimum length for any new or changed password (existing ones keep working).
# PASSWORD_MIN_LENGTH=10

# Per-IP request budgets (per minute) and temporary account lockout.
# LOGIN_RATE_PER_MIN=20
# PUBLIC_RATE_PER_MIN=600
# ACCOUNT_LOCK_THRESHOLD=10
# ACCOUNT_LOCK_MS=900000

# Lifetime of the signed token obtained with a share password (12 h), and
# whether legacy ?password= links are still accepted during the transition.
# SHARE_ACCESS_TTL_MS=43200000
# SHARE_PASSWORD_QUERY_COMPAT=1

# Optional: disable recursive file watch (0)
# ENABLE_WATCH=1

# ---- Media analysis (ffprobe): real codecs, DTS / 5.1 detection ----
# PROBE_ENABLED=true            # master switch (default true)
# PROBE_ON_SCAN=false           # trickle-probe new files after scan (default false = lazy on first view)
# FFPROBE_PATH=ffprobe
# Sur le paquet SPK, FFMPEG_PATH/FFPROBE_PATH sont lus dans
# etc/nas-simple-media.env : vide = automatique (ffmpeg6/7 du NAS, sinon les
# binaires statiques fournis dans target/app/bin).
# PROBE_TIMEOUT_MS=15000

# ---- Transcoding (Compatible / HLS) — Plex-like engine ----
# Direct Stream (video copy) + full transcode fallback, stereo or surround audio.
TRANSCODE_ENABLED=true
FFMPEG_PATH=ffmpeg
TRANSCODE_MAX_JOBS=1
# TRANSCODE_CACHE_TTL_MS=7200000
# STREAM_TOKEN_TTL_MS=86400000

# Video: remux without re-encoding when possible (huge CPU saving on NAS)
# TRANSCODE_VIDEO_COPY=true
# TRANSCODE_COPY_CODECS=h264,mpeg4
# TRANSCODE_PRESET=veryfast
# TRANSCODE_CRF=23

# Hardware acceleration: none | auto | qsv | vaapi (needs /dev/dri, see docker-compose)
# TRANSCODE_HWACCEL=none
# TRANSCODE_VAAPI_DEVICE=/dev/dri/renderD128

# Surround: DTS / DTS-HD / TrueHD / AC-3 / FLAC 5.1/7.1 → multichannel in Compatible mode
# TRANSCODE_SURROUND_CODEC=aac     # aac (default, universal) | eac3 | ac3 (Safari/TV)
# TRANSCODE_SURROUND_BITRATE=384k
# TRANSCODE_STEREO_BITRATE=192k
# TRANSCODE_AUDIO_PASSTHROUGH=false # allow AC-3/E-AC-3 bitstream passthrough (Safari/Apple only)

# Thumbnails (video posters extracted with ffmpeg, cached)
# THUMBS_ENABLED=true
