# Root folder that contains library subfolders (Movies, Series, Music, …)
MEDIA_PATH=/media

# SQLite + app data (+ cache/transcode)
DATA_PATH=/data

# HTTP port
PORT=8096

# Initial admin password (user "admin" is created on first start)
ADMIN_PASSWORD=changeme

# Public base URL for share links and VLC stream URLs
# Examples: http://192.168.1.50:8096  https://media.tailnet.ts.net
PUBLIC_BASE_URL=http://localhost:8096

# Optional: disable recursive file watch (0)
# ENABLE_WATCH=1

# Transcoding (Compatible / HLS H.264+AAC stereo) — heavy on Synology CPU
TRANSCODE_ENABLED=true
FFMPEG_PATH=ffmpeg
TRANSCODE_MAX_JOBS=1
# TRANSCODE_CACHE_TTL_MS=7200000
# STREAM_TOKEN_TTL_MS=86400000
