{
  "name": "nas-simple-media",
  "version": "1.1.0",
  "description": "Simple free Plex-like media server for Synology NAS \u2014 movies, music, TV series, ffmpeg Compatible playback, VLC/download",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/heuristics.test.ts tests/token.test.ts tests/formats.test.ts tests/streamTokens.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "media-server",
    "nas",
    "synology",
    "streaming"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
