#!/bin/sh
# postuninst — runs after the package files are removed.

. "$(dirname "$0")/common.sh"

log "post-uninstall for ${PKGNAME}"

rm -f "${PIDFILE}" 2>/dev/null

cat <<EOF

-------------------------------------------------------------------------------
 nas-simple-media has been uninstalled.

 Your media files and the "media" shared folder were never touched.  Only
 these package-owned paths are gone:
   ${VAR_DIR}      (SQLite database, share metadata, HLS cache)
   ${ENVFILE}      (runtime configuration)

 To reinstall later without losing the library database, back up
 ${VAR_DIR}/library.db beforehand and restore it into the new package's
 var/ directory after installation.  Upgrades (installing the new .spk over
 the old one) preserve the database and configuration automatically.
-------------------------------------------------------------------------------

EOF

log "post-uninstall done"
exit 0
