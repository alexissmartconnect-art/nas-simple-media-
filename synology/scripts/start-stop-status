#!/bin/sh
# start-stop-status for nas-simple-media (DSM 7).
#
# Invoked by Package Center with one of: start | stop | status | save | restore.
# The node process itself runs as the package user sc-nas-simple-media and
# writes its own PID file before exec'ing, so the recorded PID is exact.

. "$(dirname "$0")/common.sh"

# Wait until /health answers.  The node runtime is already a hard dependency,
# so use its built-in fetch instead of relying on curl/wget being installed.
wait_for_health() {
  _port="${1:-${APP_PORT}}"
  _node="$(find_node 2>/dev/null || true)"
  [ -n "${_node}" ] || return 0
  _i=0
  while [ "${_i}" -lt 60 ]; do
    if "${_node}" -e "fetch('http://127.0.0.1:${_port}/health',{signal:AbortSignal.timeout(1500)}).then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.5
    _i=$((_i + 1))
  done
  return 1
}

rotate_log() {
  [ -f "${LOGFILE}" ] || return 0
  _size="$(wc -c < "${LOGFILE}" 2>/dev/null | tr -d ' ')"
  case "${_size}" in
    ''|*[!0-9]*) return 0 ;;
  esac
  if [ "${_size}" -gt 5242880 ]; then
    mv -f "${LOGFILE}" "${LOGFILE}.1" 2>/dev/null || true
  fi
}

start() {
  if is_running; then
    log "already running (pid $(cat "${PIDFILE}"))"
    return 0
  fi

  [ -f "${APPDIR}/dist/index.js" ] || die "application not installed at ${APPDIR}"

  NODE_BIN="$(find_node)" || die "no Node.js runtime found. Install the Synology 'Node.js v22' package."
  if ! node_is_supported "${NODE_BIN}"; then
    die "Node.js $(node_version "${NODE_BIN}") is too old; the bundled SQLite driver needs >= ${NODE_MIN_MAJOR}.${NODE_MIN_MINOR}. Install the Synology 'Node.js v22' package."
  fi

  [ -f "${ENVFILE}" ] || write_env_file
  ensure_dirs
  chown_to_service
  rotate_log

  # Start detached, as the service user sc-nas-simple-media, stdin closed, output appended.
  # On DSM 7 Package Center already runs this script as sc-nas-simple-media.
  if [ "$(id -u 2>/dev/null)" = "0" ]; then
    nohup su -s /bin/sh "${SERVICE_USER}" -c "exec ${APPDIR}/bin/run.sh" \
      >>"${LOGFILE}" 2>&1 </dev/null &
  else
    nohup "${APPDIR}/bin/run.sh" \
      >>"${LOGFILE}" 2>&1 </dev/null &
  fi

  # Wait for run.sh to publish its PID.
  _i=0
  while [ ! -s "${PIDFILE}" ] && [ "${_i}" -lt 50 ]; do
    sleep 0.2
    _i=$((_i + 1))
  done

  if is_running; then
    _port="$(env_value PORT 2>/dev/null || true)"
    [ -n "${_port}" ] || _port="${APP_PORT}"
    if wait_for_health "${_port}"; then
      log "started (pid $(cat "${PIDFILE}")) on port ${_port}"
      return 0
    fi
    warn "process $(cat "${PIDFILE}") is running but /health did not answer yet; check ${LOGFILE}"
    return 0
  fi

  warn "service did not report a PID; check ${LOGFILE}"
  return 1
}

stop() {
  if ! is_running; then
    rm -f "${PIDFILE}"
    log "not running"
    return 0
  fi

  _pid="$(cat "${PIDFILE}")"
  log "stopping pid ${_pid}"
  kill -TERM "${_pid}" 2>/dev/null

  _i=0
  while kill -0 "${_pid}" 2>/dev/null && [ "${_i}" -lt 30 ]; do
    sleep 1
    _i=$((_i + 1))
  done

  if kill -0 "${_pid}" 2>/dev/null; then
    warn "process did not exit, sending SIGKILL"
    kill -KILL "${_pid}" 2>/dev/null
    sleep 1
  fi

  rm -f "${PIDFILE}"
  log "stopped"
  return 0
}

status() {
  if is_running; then
    log "running (pid $(cat "${PIDFILE}"))"
    exit 0
  fi
  rm -f "${PIDFILE}" 2>/dev/null || true
  log "stopped"
  exit 3
}

case "$1" in
  start)
    start
    ;;
  stop)
    stop
    ;;
  restart)
    stop
    start
    ;;
  status)
    status
    ;;
  prestart|prestop)
    # DSM may probe these before start/stop; nothing special to prepare.
    exit 0
    ;;
  save|restore)
    # DSM backup hook: the env file and var/ are already persistent.
    exit 0
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status|save|restore}" >&2
    exit 1
    ;;
esac
